{
  "name": "hermes-pentbox",
  "productName": "HermesPentBox",
  "version": "0.1.0",
  "private": true,
  "description": "AI 渗透工作台 - 浏览器/SSH终端/流量代理 交给 Hermes Agent",
  "type": "module",
  "main": "out/main.cjs",
  "scripts": {
    "build": "node node_modules/esbuild/bin/esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --external:ws --external:ssh2 --external:chrome-remote-interface --external:playwright-core --outfile=out/main.cjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test core/utils.test.ts core/webshell.test.ts",
    "test:proxy": "tsx core/proxy.test.ts",
    "test:api": "tsx core/api.test.ts",
    "test:browser": "tsx core/browser.test.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chrome-remote-interface": "^0.34.0",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "neo4j-driver": "^6.2.0",
    "node-forge": "^1.4.0",
    "playwright-core": "^1.62.1",
    "socks": "^2.8.9",
    "socks-proxy-agent": "^10.1.0",
    "ssh2": "^1.17.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.34.0",
    "@types/node": "^26.2.0",
    "@types/node-forge": "^1.3.14",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.hermes.pentbox",
    "productName": "HermesPentBox",
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "files": [
      "out/**",
      "electron/**",
      "ui/**",
      "core/**",
      "assets/**",
      "tools/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
